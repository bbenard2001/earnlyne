# Copy this file to .env.local for local development, and add the same values in Vercel → Project → Settings → Environment Variables.

# Your site's public address (no trailing slash). Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys (or the Connect button → App Frameworks → Next.js)
# Either the new keys (sb_publishable_… / sb_secret_…) or the legacy JWT keys (eyJ…) work.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...  # or the legacy anon key
# Secret. Never expose in the browser or commit to GitHub.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...  # or the legacy service_role key

# Stripe → Developers → API keys (use test keys until launch)
STRIPE_SECRET_KEY=sk_test_...
# Stripe → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe → Product catalog → earnlYne Pro → each price's ID
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...
STRIPE_PRICE_LIFETIME=price_...
